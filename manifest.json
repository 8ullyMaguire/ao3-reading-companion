{
  "manifest_version": 3,
  "name": "Darkhold Companion",
  "version": "1.0.0",
  "description": "The Darkhold client: shows your instance's recommendations, in the instance's order, with the reasons it recorded.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lorehaven-companion@lorehaven",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Darkhold Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": [
      "db.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "*://*/*"
  ]
}
